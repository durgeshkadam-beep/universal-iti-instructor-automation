rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isPrincipal() { return signedIn() && request.auth.token.role == 'principal'; }
    function isInstructor() { return signedIn() && request.auth.token.role == 'instructor'; }
    function sameUser() { return signedIn() && resource.data.instructorId == request.auth.uid; }

    match /users/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isPrincipal());
      allow create, update, delete: if isPrincipal();
    }

    match /instructors/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isPrincipal());
      allow create, update, delete: if isPrincipal();
    }

    match /workspaces/{workspaceId} {
      allow read: if signedIn() && (isPrincipal() || request.auth.uid == workspaceId);
      allow write: if signedIn() && (isPrincipal() || request.auth.uid == workspaceId);
      match /{document=**} {
        allow read, write: if signedIn() && (isPrincipal() || request.auth.uid == workspaceId);
      }
    }
  }
}
