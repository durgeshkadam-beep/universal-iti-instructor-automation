rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function institutePath(inst) { return /databases/$(database)/documents/institutes/$(inst); }
    function memberPath(inst, uid) { return /databases/$(database)/documents/institutes/$(inst)/members/$(uid); }
    function accessPath(inst, email) { return /databases/$(database)/documents/institutes/$(inst)/access/$(email); }
    function secretPath(inst, email) { return /databases/$(database)/documents/institutes/$(inst)/inviteSecrets/$(email); }
    function legacyManifestPath(uid, wid) { return /databases/$(database)/documents/itiInstructorUsers/$(uid)/workspaces/$(wid)/sections/_manifest; }
    function isOwner(inst) { return signedIn() && exists(institutePath(inst)) && get(institutePath(inst)).data.ownerUid == request.auth.uid; }
    function hasMember(inst) { return signedIn() && exists(memberPath(inst, request.auth.uid)) && get(memberPath(inst)).data.active == true; }
    function member(inst) { return get(memberPath(inst, request.auth.uid)).data; }
    function isRealPrincipal(inst) { return hasMember(inst) && member(inst).role == 'principal'; }
    function isInstructor(inst) { return hasMember(inst) && member(inst).role == 'instructor'; }
    function isStaff(inst) { return isOwner(inst) || isRealPrincipal(inst) || isInstructor(inst); }
    function workspaceAllowed(inst, wid) { return isOwner(inst) || (hasMember(inst) && wid in member(inst).workspaceIds); }
    function ownTrainee(inst, traineeId) { return hasMember(inst) && member(inst).role == 'student' && member(inst).traineeId == traineeId; }
    function publicStudentSection(section) { return section in ['theory','practicals','notices','holidays','modules','extraTopics','visits','activities','exams']; }
    function ownerCanCreateRole(inst, role) { return isOwner(inst) && role in ['principal','instructor','student']; }
    function principalCanCreateRole(inst, role) { return isRealPrincipal(inst) && role == 'instructor'; }
    function instructorCanCreateRole(inst, role) { return isInstructor(inst) && role == 'student'; }

    // Preserve the original V14 private cloud for safe migration / rollback.
    match /itiInstructorUsers/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /institutes/{inst} {
      allow get: if signedIn();
      allow list: if isOwner(inst) || hasMember(inst);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.legacyWorkspaceId is string
        && exists(legacyManifestPath(request.auth.uid, request.resource.data.legacyWorkspaceId));
      allow update: if isOwner(inst) || isRealPrincipal(inst);
      allow delete: if false;

      match /access/{email} {
        allow get: if signedIn() && (isStaff(inst) || request.auth.token.email == email);
        allow list: if isStaff(inst);
        allow create, update: if ownerCanCreateRole(inst, request.resource.data.role)
          || principalCanCreateRole(inst, request.resource.data.role)
          || instructorCanCreateRole(inst, request.resource.data.role);
        allow delete: if isOwner(inst)
          || (isRealPrincipal(inst) && resource.data.role == 'instructor')
          || (isInstructor(inst) && resource.data.role == 'student');
      }

      match /inviteSecrets/{email} {
        allow read: if isStaff(inst);
        allow create: if ownerCanCreateRole(inst, request.resource.data.role)
          || principalCanCreateRole(inst, request.resource.data.role)
          || instructorCanCreateRole(inst, request.resource.data.role);
        allow update: if ownerCanCreateRole(inst, request.resource.data.role)
          || principalCanCreateRole(inst, request.resource.data.role)
          || instructorCanCreateRole(inst, request.resource.data.role)
          || (
            signedIn()
            && request.auth.token.email == email
            && hasMember(inst)
            && member(inst).email == email
            && member(inst).activationProof == resource.data.codeHash
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','usedAt','usedBy'])
            && request.resource.data.active == false
            && request.resource.data.usedBy == request.auth.uid
          );
        allow delete: if isOwner(inst)
          || (isRealPrincipal(inst) && resource.data.role == 'instructor')
          || (isInstructor(inst) && resource.data.role == 'student');
      }

      match /members/{memberId} {
        allow read: if isStaff(inst) || (signedIn() && memberId == request.auth.uid);
        allow create: if signedIn() && memberId == request.auth.uid && (
          isOwner(inst)
          || (
            request.auth.token.email != null
            && exists(accessPath(inst, request.auth.token.email))
            && exists(secretPath(inst, request.auth.token.email))
            && get(accessPath(inst, request.auth.token.email)).data.active == true
            && get(secretPath(inst, request.auth.token.email)).data.active == true
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == get(accessPath(inst, request.auth.token.email)).data.role
            && request.resource.data.workspaceIds == get(accessPath(inst, request.auth.token.email)).data.workspaceIds
            && request.resource.data.traineeId == get(accessPath(inst, request.auth.token.email)).data.traineeId
            && request.resource.data.activationProof == get(secretPath(inst, request.auth.token.email)).data.codeHash
          )
        );
        allow update: if
          (isOwner(inst) && resource.data.owner != true && request.resource.data.owner != true)
          || (
            isRealPrincipal(inst)
            && resource.data.owner != true
            && resource.data.role == 'instructor'
            && request.resource.data.role == 'instructor'
            && request.resource.data.owner == resource.data.owner
          );
        allow delete: if
          (isOwner(inst) && resource.data.owner != true)
          || (isRealPrincipal(inst) && resource.data.owner != true && resource.data.role == 'instructor');
      }

      match /workspaces/{wid} {
        allow read: if workspaceAllowed(inst, wid);
        allow create, update: if workspaceAllowed(inst, wid) && isStaff(inst);
        allow delete: if isOwner(inst) || isRealPrincipal(inst);

        match /trainees/{docId} {
          allow read: if workspaceAllowed(inst, wid) && (isStaff(inst) || (resource.data.data.id != null && ownTrainee(inst, resource.data.data.id)));
          allow create, update, delete: if workspaceAllowed(inst, wid) && isStaff(inst);
        }
        match /attendance/{docId} {
          allow read: if workspaceAllowed(inst, wid) && (isStaff(inst) || ownTrainee(inst, resource.data.traineeId));
          allow create, update, delete: if workspaceAllowed(inst, wid) && isStaff(inst);
        }
        match /marks/{docId} {
          allow read: if workspaceAllowed(inst, wid) && (isStaff(inst) || ownTrainee(inst, resource.data.traineeId));
          allow create, update, delete: if workspaceAllowed(inst, wid) && isStaff(inst);
        }
        match /submissions/{docId} {
          allow read: if workspaceAllowed(inst, wid) && (isStaff(inst) || ownTrainee(inst, resource.data.traineeId));
          allow create, update: if workspaceAllowed(inst, wid) && (isStaff(inst) || ownTrainee(inst, request.resource.data.traineeId));
          allow delete: if workspaceAllowed(inst, wid) && isStaff(inst);
        }
        match /leaves/{docId} {
          allow read: if workspaceAllowed(inst, wid) && (isStaff(inst) || ownTrainee(inst, resource.data.data.traineeId));
          allow create: if workspaceAllowed(inst, wid) && (isStaff(inst) || ownTrainee(inst, request.resource.data.data.traineeId));
          allow update, delete: if workspaceAllowed(inst, wid) && isStaff(inst);
        }
        match /examAttempts/{docId} {
          allow read: if workspaceAllowed(inst, wid) && (isStaff(inst) || ownTrainee(inst, resource.data.data.traineeId));
          allow create, update: if workspaceAllowed(inst, wid) && (isStaff(inst) || ownTrainee(inst, request.resource.data.data.traineeId));
          allow delete: if workspaceAllowed(inst, wid) && isStaff(inst);
        }
        match /projects/{docId} {
          allow read: if workspaceAllowed(inst, wid) && (isStaff(inst) || ownTrainee(inst, resource.data.data.traineeId));
          allow create, update, delete: if workspaceAllowed(inst, wid) && isStaff(inst);
        }
        match /state/{docId} {
          allow read, write: if workspaceAllowed(inst, wid) && isStaff(inst);
        }
        match /{section}/{docId} {
          allow read: if workspaceAllowed(inst, wid) && (isStaff(inst) || publicStudentSection(section));
          allow create, update, delete: if workspaceAllowed(inst, wid) && isStaff(inst);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
