# Backend environment only; never place credentials in public hosting or browser storage.
GCLOUD_PROJECT=your-staging-project
ALLOWED_ORIGINS=https://your-staging-host.example
AI_PROVIDER=none
# Optional self-hosted free model; compute is your responsibility.
# AI_PROVIDER=ollama
# OLLAMA_URL=http://127.0.0.1:11434
# AI_MODEL=installed-model-name
# Optional external provider. Verify current free quotas and data terms before enabling.
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.5-flash-lite
# AI_API_KEY=inject-from-Render-secret-not-source-code
# Verify Free Tier eligibility, billing settings, and limits in Google AI Studio.
# App limits alone cannot guarantee zero charges if the API project is billable.
AI_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=100

# Local proxy: keep loopback. Containers: set HOST=0.0.0.0 and use platform PORT.
HOST=127.0.0.1
PORT=8787

# Optional isolated Render staging deployment: see docs/RENDER-STAGING.md.
# ITI_STAGING_ONLY=true
# GCLOUD_PROJECT=universal-iti-dk-staging
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/iti-staging-service-account.json
